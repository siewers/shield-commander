<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShieldCommander</AssemblyName>
    <Product>Shield Commander</Product>
    <!-- Overridden from the release tag in CI -->
    <Version>0.0.0-dev</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2"/>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0"/>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-798"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShieldCommander.Core\ShieldCommander.Core.csproj"/>
  </ItemGroup>
</Project>
